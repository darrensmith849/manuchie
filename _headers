# Cloudflare Pages headers (ignored by other hosts — safe to keep)
#
# CSP allows exactly what the page uses:
#   self ............ page, styles, scripts, self-hosted fonts, images
#   data: ........... favicon + film-grain SVG (img-src)
#   open.spotify.com  Spotify player iframe + reachability probe script
#   embed.music.apple.com  Apple Music fallback player (only if Spotify is blocked)
#   mailto: ........ booking form opens the visitor's email app
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' https://open.spotify.com; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self'; frame-src https://open.spotify.com https://embed.music.apple.com; form-action 'self' mailto:; base-uri 'self'; object-src 'none'; frame-ancestors 'self'; upgrade-insecure-requests
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  Strict-Transport-Security: max-age=31536000

# HTML always revalidates, so updates show immediately
/
  Cache-Control: public, max-age=0, must-revalidate
/index.html
  Cache-Control: public, max-age=0, must-revalidate

# CSS, JS and images are referenced with a content hash (?v=…, added by build.sh),
# fonts have content-hashed filenames — a changed file gets a new URL, so cache for a year
/*.css
  Cache-Control: public, max-age=31536000, immutable
/*.js
  Cache-Control: public, max-age=31536000, immutable
/assets/*
  Cache-Control: public, max-age=31536000, immutable
